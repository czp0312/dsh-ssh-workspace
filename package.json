{
  "name": "dsh-ssh-workspaces",
  "version": "0.3.3",
  "description": "SSH, WSL and Docker projects in the native DSH sidebar, with lightweight/full modes and selective Skill sync",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czp0312/dsh-ssh-workspace.git"
  },
  "homepage": "https://github.com/czp0312/dsh-ssh-workspace#readme",
  "bugs": {
    "url": "https://github.com/czp0312/dsh-ssh-workspace/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "types": "lib/types/src/index.d.ts",
  "bin": {
    "dsh-ssh-askpass": "lib/ssh-askpass.cjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/ssh-askpass.cjs",
    "lib/ssh-askpass.exe",
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/src/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "screenshots.json",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "wsl",
    "docker",
    "skills",
    "remote-workspace"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  }
}
